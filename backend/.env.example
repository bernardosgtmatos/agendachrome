# Configuração do Backend - Chromebook Agendamento
# Copie este arquivo para .env e preencha os valores

# Banco de dados (PostgreSQL em produção)
# Para desenvolvimento local, use: file:./dev.db
DATABASE_URL="postgresql://usuario:senha@host:5432/dbname"

# Segredo para tokens JWT (mude para uma string segura em produção)
JWT_SECRET="sua-chave-secreta-aqui"

# Porta do servidor
PORT=3000

# URL do frontend (para CORS)
FRONTEND_URL="https://seu-app.onrender.com"

# Ambiente
NODE_ENV="production"
