// Gerador do Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Fonte de dados
// Banco em todos os ambientes: PostgreSQL (Supabase)
// DATABASE_URL  → connection string do pooler (porta 6543, ?pgbouncer=true)
// DIRECT_URL    → connection string direta (porta 5432, usada por migrations/seed)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== MODELOS ====================

// Usuário do sistema: professor ou coordenador
model Usuario {
  id        Int           @id @default(autoincrement())
  nome      String
  email     String        @unique
  senha     String        // hash bcrypt
  role      String        @default("professor") // "professor" | "coordenador"
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  agendamentos Agendamento[] @relation("ProfessorAgendamentos")
}

// Turma escolar (ex: "6° Ano A")
model Turma {
  id        Int           @id @default(autoincrement())
  nome      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  agendamentos Agendamento[]
}

// Configuração do sistema (singleton — sempre 1 registro)
model Configuracao {
  id               Int  @id @default(autoincrement())
  limiteChromebooks Int @default(36)
}

// Agendamento de chromebooks para uma turma em uma data/horário
model Agendamento {
  id               Int       @id @default(autoincrement())
  professorId      Int
  professor        Usuario   @relation("ProfessorAgendamentos", fields: [professorId], references: [id])
  turmaId          Int
  turma            Turma     @relation(fields: [turmaId], references: [id])
  quantidade       Int
  data             DateTime  // Apenas a data (YYYY-MM-DD), sem hora
  horarioRetirada  String    // Nome do horário de retirada
  horarioDevolucao String    // Nome do horário de devolução
  observacoes      String?
  status           String    @default("ativo") // "ativo" | "cancelado"
  dataCriacao      DateTime  @default(now())
  dataCancelamento DateTime?

  @@index([data, status])
  @@index([professorId])
  @@index([turmaId])
}
